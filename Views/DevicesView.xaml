<UserControl x:Class="NetConfigPro.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="设备管理" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="维护设备资产清单，供「批量部署」页面选择目标设备"
                       FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Padding="12,10" Margin="0,0,0,12" CornerRadius="6"
                Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Button Content="新增设备" Style="{StaticResource PrimaryButton}" Click="BtnAdd_Click" />
                <Button Content="编辑" Margin="8,0,0,0" Click="BtnEdit_Click" />
                <Button Content="删除" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="BtnDelete_Click" />
                <Button Content="导出 CSV" Margin="8,0,0,0" Click="BtnExport_Click" />
                <Button Content="刷新" Margin="8,0,0,0" Click="BtnRefresh_Click" />
                <TextBlock x:Name="TxtCount" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{StaticResource TextDimBrush}" FontSize="12" />
            </StackPanel>
        </Border>

        <DataGrid x:Name="GridDevices" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" MouseDoubleClick="GridDevices_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="150" />
                <DataGridTextColumn Header="厂商" Binding="{Binding VendorText}" Width="80" />
                <DataGridTextColumn Header="类型" Binding="{Binding DeviceText}" Width="90" />
                <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="130" />
                <DataGridTextColumn Header="管理 IP" Binding="{Binding Ip}" Width="130" />
                <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="65" />
                <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="90" />
                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"
                   Text="提示：双击行可直接编辑。密码加密保存在本机，导出 CSV 时不会包含密码字段。" />
    </Grid>
</UserControl>
