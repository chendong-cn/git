<UserControl x:Class="NetConfigPro.Views.DiagView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="网络命令" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Windows 本机网络诊断命令合集 —— ping / tracert / arp / netstat / nslookup / ipconfig / curl / netsh 等，填目标一键生成，也可在本机直接执行查看结果"
                       FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 主体：左栏选择 / 右栏输出 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左栏 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="{StaticResource SideBgBrush}"
                          BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderBrush}">
                <StackPanel Margin="16,16,16,20">

                    <!-- 目标与端口 -->
                    <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="目标与端口（支持 IP 或域名）" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" />
                            <TextBox x:Name="TxtTarget" Margin="0,6,0,0" Padding="8,6"
                                     ToolTip="填 IP 或域名；HTTP/HTTPS 探测类命令需带 http:// 或 https:// 前缀&#x0a;留空时自动跳过需要目标的命令"
                                     TextChanged="Target_TextChanged" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="端口" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1" x:Name="TxtPort" Text="80" Padding="8,5"
                                         ToolTip="端口连通性 / 指定端口占用等命令使用的端口号"
                                         TextChanged="Target_TextChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="诊断命令" Style="{StaticResource SectionTitle}" Margin="0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="全选" Style="{StaticResource IconButton}" Click="BtnSelectAll_Click" />
                            <Button Content="清空" Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnClearAll_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="勾选要用的命令；目标留空时「需要目标」的命令自动跳过"
                               Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <StackPanel x:Name="GroupHost" />

                    <TextBlock x:Name="TxtSummary" Text="已选 0 条" FontSize="11"
                               Foreground="{StaticResource AccentCyanBrush}" Margin="0,10,0,0" FontWeight="SemiBold" />
                    <TextBlock Text="注：标注“需管理员”的命令请复制到管理员终端执行；设备侧的连通测试请用「一键巡检」"
                               FontSize="10.5" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- 右栏：预览 + 执行结果 -->
            <Grid Grid.Column="1" Background="{StaticResource BgBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4*" MinHeight="130" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="14,12" Background="{StaticResource PanelBgBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="命令预览（带说明）" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentCyanBrush}" />
                            <TextBlock x:Name="TxtStat" Text="0 条命令" FontSize="11"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="生成 / 刷新" Style="{StaticResource PrimaryButton}" Click="BtnGenerate_Click" />
                            <Button Content="复制命令" Style="{StaticResource IconButton}" Margin="8,0,0,0" Click="BtnCopy_Click"
                                    ToolTip="复制纯命令（无 # 注释行），可直接粘贴到 cmd / PowerShell 执行" />
                            <Button Content="导出 .txt" Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnExport_Click"
                                    ToolTip="导出纯命令文本，用于离线保存或批量执行" />
                            <Button Content="生成检查报告" Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnReport_Click"
                                    ToolTip="把下方“本机执行结果”整理成带问题分析的 HTML 报告，可直接发给客户" />
                        </StackPanel>
                    </Grid>
                </Border>

                <RichTextBox x:Name="OutputBox" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Padding="8,8,8,8"
                             Background="{StaticResource OutputBgBrush}" VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource MonoFont}" FontSize="12" />

                <Border Grid.Row="2" Padding="14,8" Background="{StaticResource PanelBgBrush}"
                        BorderThickness="0,1,0,1" BorderBrush="{StaticResource BorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="本机执行结果" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentGreenBrush}" />
                            <TextBlock x:Name="TxtRunHint" Text="  点击右侧按钮在 Windows 上直接运行勾选的命令（持续/交互式命令自动降级，逐条 ≤60s）"
                                       FontSize="11" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnRun" Content="本机执行" Style="{StaticResource PrimaryButton}" Click="BtnRun_Click"
                                    ToolTip="逐条在本机执行勾选的命令，结果实时追加到下方（慢命令置后，超时自动终止）" />
                            <Button x:Name="BtnStop" Content="停止" Style="{StaticResource DangerButton}" Margin="6,0,0,0"
                                    Click="BtnStop_Click" IsEnabled="False"
                                    ToolTip="停止执行：正在运行的命令约 1 秒内终止，其余不再启动" />
                            <Button Content="清空结果" Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnClearResult_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <RichTextBox x:Name="ResultBox" Grid.Row="3" IsReadOnly="True" BorderThickness="0" Padding="8,8,8,8"
                             Background="{StaticResource OutputBgBrush}" VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
