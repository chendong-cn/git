<UserControl x:Class="NetConfigPro.Views.TemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="模板库" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="保存常用参数组合，应用到生成器后可直接微调并重新生成配置"
                       FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Padding="12,10" Margin="0,0,0,12" CornerRadius="6"
                Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Button Content="应用到生成器" Style="{StaticResource PrimaryButton}" Click="BtnApply_Click" />
                <Button Content="预览配置" Margin="8,0,0,0" Click="BtnPreview_Click" />
                <Button Content="重命名" Margin="8,0,0,0" Click="BtnRename_Click" />
                <Button Content="删除" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="BtnDelete_Click" />
                <Button Content="刷新" Margin="8,0,0,0" Click="BtnRefresh_Click" />
            </StackPanel>
        </Border>

        <DataGrid x:Name="GridTemplates" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  MouseDoubleClick="GridTemplates_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="模板名称" Binding="{Binding Name}" Width="180" />
                <DataGridTextColumn Header="厂商" Binding="{Binding VendorText}" Width="75" />
                <DataGridTextColumn Header="设备类型" Binding="{Binding DeviceTypeText}" Width="90" />
                <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"
                   Text="模板在「配置生成器」页面通过「存为模板」按钮创建，保存时包含当前全部参数与模块勾选状态。" />
    </Grid>
</UserControl>
