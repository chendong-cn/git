<Window x:Class="NetConfigPro.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NetConfigPro 网络设备配置专家" Height="920" Width="1480"
        MinHeight="720" MinWidth="1180"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" CornerRadius="10" Background="{StaticResource BgBaseBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#FF26415E" BlurRadius="18" ShadowDepth="0" Opacity="0.2" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- ==================== 标题栏 ==================== -->
            <Border Grid.Row="0" Background="{StaticResource PanelBgBrush}" CornerRadius="10,10,0,0"
                    BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Path Width="22" Height="22" Stretch="Uniform" Fill="{StaticResource AccentCyanBrush}"
                              Data="M12 2 L21 7 V17 L12 22 L3 17 V7 Z M12 7 L16.5 9.5 V14.5 L12 17 L7.5 14.5 V9.5 Z"
                              Opacity="0.9">
                            <Path.Effect>
                                <DropShadowEffect Color="{StaticResource AccentCyan}" BlurRadius="8" ShadowDepth="0" Opacity="0.45" />
                            </Path.Effect>
                        </Path>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NetConfigPro" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="│" Foreground="{StaticResource BorderBrush}" Margin="10,0" />
                        <TextBlock Text="网络设备配置专家" FontSize="12" Foreground="{StaticResource AccentCyanBrush}" />
                        <Border Background="{StaticResource SelectedFillBrush}" CornerRadius="3" Padding="6,2" Margin="12,0,0,0">
                            <TextBlock Text="Huawei · H3C · Cisco · Ruijie" FontSize="10.5"
                                       Foreground="{StaticResource AccentCyanBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WinBtn}" Click="BtnTheme_Click" ToolTip="皮肤颜色（32 种主色可选）">
                            <Path Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource AccentCyanBrush}"
                                  Data="M12,22A10,10 0 0 1 12,2A10,10 0 0 1 22,12A6,6 0 0 1 16,18H14.5A1.5,1.5 0 0 0 13,19.5A1.5,1.5 0 0 0 14.5,21H16A6,6 0 0 1 12,22M7.5,10A1.5,1.5 0 1 0 7.5,7A1.5,1.5 0 0 0 7.5,10M12,6A1.5,1.5 0 1 0 12,3A1.5,1.5 0 0 0 12,6M16.5,8A1.5,1.5 0 1 0 16.5,5A1.5,1.5 0 0 0 16.5,8M17,13.5A1.5,1.5 0 1 0 17,10.5A1.5,1.5 0 0 0 17,13.5Z" />
                        </Button>
                        <Button Style="{StaticResource WinBtn}" Content="—" Click="BtnMinimize_Click" ToolTip="最小化" />
                        <Button Style="{StaticResource WinBtn}" Content="▢" Click="BtnMaximize_Click" ToolTip="最大化/还原" />
                        <Button Style="{StaticResource WinBtnClose}" Content="✕" Click="BtnClose_Click" ToolTip="关闭" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 主内容 ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 侧边导航 -->
                <Border Grid.Column="0" Background="{StaticResource SideBgBrush}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="12,16,12,0">
                            <TextBlock Text="功能导航" FontSize="10.5" Foreground="{StaticResource TextDimBrush}"
                                       Margin="10,0,0,10" FontWeight="SemiBold" />

                            <RadioButton x:Name="NavGenerator" Style="{StaticResource NavRadio}" Tag="generator"
                                         IsChecked="True" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M13 2 L5 13 H11 L10 22 L19 10 H13 Z" Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round" />
                                    <TextBlock Text="配置生成器" Margin="12,0,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavDevices" Style="{StaticResource NavRadio}" Tag="devices" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3 4 H21 V10 H3 Z M3 14 H21 V20 H3 Z" Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" Fill="Transparent" />
                                    <TextBlock Text="设备管理" Margin="12,0,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavDeploy" Style="{StaticResource NavRadio}" Tag="deploy" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12 3 L20 11 H15 V21 H9 V11 H4 Z" Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round" />
                                    <TextBlock Text="批量部署" Margin="12,0,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavInspection" Style="{StaticResource NavRadio}" Tag="inspection" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M10 2 A8 8 0 1 0 10 18 A8 8 0 0 0 10 2 M10 6.5 V13.5 M6.5 10 H13.5"
                                          Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round" />
                                    <TextBlock Text="一键巡检" Margin="12,0,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavDiag" Style="{StaticResource NavRadio}" Tag="diag" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3 3 H21 V21 H3 Z M7 7 L10.5 10 L7 13 M13.5 13 H17"
                                          Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round" />
                                    <TextBlock Text="网络命令" Margin="12,0,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavCompare" Style="{StaticResource NavRadio}" Tag="compare" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3 4 H11 V20 H3 Z M13 4 H21 V20 H13 Z" Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" Fill="Transparent" />
                                    <TextBlock Text="配置对比" Margin="12,0,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavTemplates" Style="{StaticResource NavRadio}" Tag="templates" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M6 2 H18 V22 H6 Z M9 7 H15 M9 11 H15 M9 15 H13" Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" Fill="Transparent" />
                                    <TextBlock Text="模板库" Margin="12,0,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavVersions" Style="{StaticResource NavRadio}" Tag="versions" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12 2 A10 10 0 1 0 12 22 A10 10 0 0 0 12 2 M12 7 V12 L16 14"
                                          Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" Fill="Transparent" />
                                    <TextBlock Text="版本管理" Margin="12,0,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavPack" Style="{StaticResource NavRadio}" Tag="pack" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3 7 L12 3 L21 7 V17 L12 21 L3 17 Z M3 7 L12 11 L21 7 M12 11 V21 M8 8 L8.5 9.5"
                                          Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round" />
                                    <TextBlock Text="交付包" Margin="12,0,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavScan" Style="{StaticResource NavRadio}" Tag="scan" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12 2 V6 M12 18 V22 M2 12 H6 M18 12 H22 M12 12 m-3.5 0 a3.5 3.5 0 1 0 7 0 a3.5 3.5 0 1 0 -7 0"
                                          Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5" Fill="Transparent" />
                                    <TextBlock Text="IP-MAC 扫描" Margin="12,0,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- 底部信息 -->
                        <Border Grid.Row="1" Margin="12,0,12,14" Padding="12,10" CornerRadius="6"
                                Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="支持矩阵" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" />
                                <TextBlock Text="路由器 / 防火墙" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0" />
                                <TextBlock Text="交换机 / 无线 AP" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 页面容器 -->
                <ContentControl x:Name="PageHost" Grid.Column="1" />
            </Grid>

            <!-- ==================== 状态栏 ==================== -->
            <Border Grid.Row="2" Background="{StaticResource PanelBgBrush}" BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource BorderBrush}" Padding="16,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentGreenBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF0D9E6E" BlurRadius="6" ShadowDepth="0" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="StatusText" Text="就绪" Margin="10,0,0,0" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="StatText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource TextDimBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
