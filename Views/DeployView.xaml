<UserControl x:Class="NetConfigPro.Views.DeployView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
            <TextBlock Text="批量部署" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="勾选目标设备并载入配置，执行前会做厂商语法特征校验"
                       FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,5,0,0" />
        </StackPanel>

        <!-- 左：目标设备 -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="12,10" Margin="0,0,0,12" CornerRadius="6" Background="{StaticResource PanelBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock Text="目标设备" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="全选" Style="{StaticResource IconButton}" Click="BtnSelectAll_Click" />
                        <Button Content="反选" Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnInvert_Click" />
                        <Button Content="清空" Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnClearSel_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataGrid x:Name="GridDevices" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="48" />
                    <DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="130" IsReadOnly="True" />
                    <DataGridTextColumn Header="厂商" Binding="{Binding VendorText}" Width="65" IsReadOnly="True" />
                    <DataGridTextColumn Header="类型" Binding="{Binding DeviceText}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="管理 IP" Binding="{Binding Ip}" Width="*" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10" CornerRadius="6"
                    Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="TxtSelected" Text="已选 0 台设备" FontSize="12"
                               Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="设备为空时，请先在「设备管理」中添加。"
                               FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 右：配置 + 日志 -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.15*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="12,10" Margin="0,0,0,12" CornerRadius="6"
                    Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock Text="配置内容" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}"
                               FontSize="13" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ComboBox x:Name="CmbVersion" Width="200" SelectionChanged="CmbVersion_SelectionChanged"
                                  ToolTip="从版本库载入配置" />
                        <Button Content="从文件载入" Style="{StaticResource IconButton}" Margin="8,0,0,0" Click="BtnLoadFile_Click" />
                        <Button Content="清空" Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnClearConfig_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="12,8" CornerRadius="6,6,0,0" Background="{StaticResource PanelBg2Brush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtConfigStat" Text="0 行" Foreground="{StaticResource TextDimBrush}" FontSize="11.5"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="enable 密码(思科/锐捷)" FontSize="10.5" Foreground="{StaticResource TextDimBrush}"
                                   Margin="16,0,6,0" VerticalAlignment="Center" />
                        <PasswordBox x:Name="TxtEnablePwd" Width="120" VerticalContentAlignment="Center"
                                     ToolTip="思科/锐捷设备从用户视图进特权模式需要的 enable 密码；华为/华三不需要" />
                        <TextBlock x:Name="TxtChannel" Text="" FontSize="10.5" Foreground="{StaticResource AccentAmberBrush}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="真实 SSH 下发" Style="{StaticResource PrimaryButton}" Click="BtnRealDeploy_Click"
                                ToolTip="用附带 plink 直连设备真实下发（账号密码取自设备清单；需设备已开启 SSH）" />
                        <Button Content="模拟执行" Style="{StaticResource IconButton}" Margin="8,0,0,0" Click="BtnExecute_Click"
                                ToolTip="不连设备，仅做厂商一致性模拟校验（原执行部署）" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBox x:Name="TxtConfig" Grid.Row="2" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                     Background="{StaticResource OutputBgBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="10,8"
                     TextChanged="TxtConfig_TextChanged" TextWrapping="NoWrap" />

            <ProgressBar x:Name="Progress" Grid.Row="2" Height="3" VerticalAlignment="Bottom" Visibility="Collapsed"
                         IsIndeterminate="True" Foreground="{StaticResource AccentCyanBrush}" Background="Transparent"
                         BorderThickness="0" />

            <Border Grid.Row="3" Padding="12,10,12,8" Margin="0,14,0,0">
                <Grid>
                    <TextBlock Text="执行日志" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="导出日志" Style="{StaticResource IconButton}" Click="BtnExportLog_Click" />
                        <Button Content="清空日志" Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnClearLog_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataGrid x:Name="GridLogs" Grid.Row="4" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="70" />
                    <DataGridTextColumn Header="设备" Binding="{Binding DeviceName}" Width="120" />
                    <DataGridTextColumn Header="管理 IP" Binding="{Binding DeviceIp}" Width="110" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80" />
                    <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
