<Window x:Class="NetConfigPro.Views.DevicePickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="选择设备" Height="460" Width="560" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="8" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource AccentCyanBrush}"
            BorderThickness="1" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="#FF26415E" BlurRadius="16" ShadowDepth="0" Opacity="0.22" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBg2Brush}" CornerRadius="8,8,0,0"
                    BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}" Padding="16,0">
                <TextBlock Text="从设备清单载入" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentCyanBrush}" />
            </Border>

            <Grid Grid.Row="1" Margin="18,14,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TxtTip" Text="选择一台设备" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDimBrush}" FontSize="11.5" Margin="0,0,0,10" />
                <ListBox x:Name="LstDevices" Grid.Row="1"
                         Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                         MouseDoubleClick="LstDevices_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding VendorText}" Foreground="{StaticResource AccentCyanBrush}"
                                               Margin="12,0,0,0" FontSize="11.5" />
                                    <TextBlock Text="{Binding DeviceText}" Foreground="{StaticResource TextDimBrush}"
                                               Margin="8,0,0,0" FontSize="11.5" />
                                    <TextBlock Text="{Binding Model}" Foreground="{StaticResource TextDimBrush}"
                                               Margin="10,0,0,0" FontSize="11" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Ip}" Foreground="{StaticResource TextDimBrush}"
                                           FontSize="11.5" FontFamily="{StaticResource MonoFont}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border Grid.Row="2" Padding="18,12,18,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Padding="18,7" Click="BtnCancel_Click" />
                    <Button Content="使用此设备" Style="{StaticResource PrimaryButton}" Padding="18,7"
                            Margin="10,0,0,0" IsDefault="True" Click="BtnOk_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
