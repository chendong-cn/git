<UserControl x:Class="NetConfigPro.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="IP-MAC 地址扫描" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="扫描局域网在线主机，列出 IP ↔ MAC 对应关系并识别设备厂商 —— 排查 IP 冲突 / ARP 欺骗 / 未知设备 / 地址台账"
                       FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 扫描参数 -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="12,10" CornerRadius="6"
                Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="310" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="扫描范围" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" x:Name="TxtCidr" Padding="8,6"
                             ToolTip="支持 CIDR / 起止区间 / 单 IP，多段用逗号分隔&#x0a;192.168.1.0/24 · 192.168.1.10-192.168.1.100 · 192.168.1.10-100 · 192.168.1.5" />
                    <Button Grid.Column="2" x:Name="BtnScan" Content="开始扫描" Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0" Click="BtnScan_Click"
                            ToolTip="对网段内每个地址发 ping 触发 ARP 解析，随后读取本机 ARP 表列出在线主机（约 2~6 秒）" />
                    <Button Grid.Column="3" x:Name="BtnStop" Content="停止" Style="{StaticResource DangerButton}"
                            Margin="6,0,0,0" IsEnabled="False" Click="BtnStop_Click"
                            ToolTip="中断当前扫描" />
                    <TextBlock Grid.Column="4" x:Name="TxtProgress" Text="" FontSize="12"
                               Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"
                               Margin="14,0,0,0" />
                </Grid>
                <TextBlock Text="原理：逐个地址 ping 前会先做 ARP 解析 —— 即使目标设备禁 ping（不回 ICMP），也会应答 ARP，因此仍能被发现；扫描 /16 以上大网段请分段进行"
                           FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 结果表 -->
        <DataGrid x:Name="GridHosts" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Ordinal}" Width="46" IsReadOnly="True" />
                <DataGridTextColumn Header="IP 地址" Binding="{Binding Ip}" Width="120" IsReadOnly="True" />
                <DataGridTextColumn Header="MAC 地址" Binding="{Binding Mac}" Width="152" IsReadOnly="True" />
                <DataGridTextColumn Header="厂商" Binding="{Binding Vendor}" Width="92" IsReadOnly="True" />
                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="58" IsReadOnly="True" />
                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLocal}" Value="True">
                            <Setter Property="Background" Value="{StaticResource HoverFillBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- 底部统计与操作 -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,10" CornerRadius="6"
                Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStat" Text="尚未扫描 —— 填好网段点「开始扫描」" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="结果仅包含在线（已应答 ARP）主机；厂商识别基于内置常用 OUI 库，未收录的显示空（可自行对照 MAC 前 3 段查询）"
                               FontSize="10.5" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="复制列表" Style="{StaticResource IconButton}" Click="BtnCopy_Click" />
                    <Button Content="导出 CSV" Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnExport_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
