<Window x:Class="NetConfigPro.Views.DeviceEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="设备信息" Height="480" Width="440" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="8" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource AccentCyanBrush}"
            BorderThickness="1" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="#FF26415E" BlurRadius="16" ShadowDepth="0" Opacity="0.22" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBg2Brush}" CornerRadius="8,8,0,0"
                    BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}" Padding="16,0">
                <TextBlock Text="设备信息" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentCyanBrush}" />
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,20,6">
                    <HeaderedContentControl Header="设备名称" Style="{StaticResource Field}">
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="厂商" Style="{StaticResource Field}">
                        <ComboBox x:Name="CmbVendor" SelectedItem="{Binding Vendor}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="设备类型" Style="{StaticResource Field}">
                        <ComboBox x:Name="CmbType" SelectedItem="{Binding DeviceType}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="设备型号" Style="{StaticResource Field}">
                        <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="管理 IP" Style="{StaticResource Field}">
                        <TextBox x:Name="TxtIp" Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="SSH 端口" Style="{StaticResource Field}">
                        <TextBox x:Name="TxtPort" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="用户名" Style="{StaticResource Field}">
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="密码" Style="{StaticResource Field}">
                        <PasswordBox x:Name="TxtPassword" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="备注" Style="{StaticResource Field}">
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                    </HeaderedContentControl>
                    <TextBlock Text="密码以 AES 加密方式保存在本机配置目录，不会上传，也不会在界面明文展示。"
                               TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="20,0,20,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Padding="18,7" Click="BtnCancel_Click" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Padding="18,7"
                            Margin="10,0,0,0" IsDefault="True" Click="BtnOk_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
