<UserControl x:Class="NetConfigPro.Views.PackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="一键交付包" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="把版本库配置 / 外部配置文件勾选打包成 ZIP 交付包（自动附带交付说明清单）——发给客户前零手工整理"
                       FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 主体：左清单 / 右预览与打包 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：清单 -->
            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="打包清单" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="载入版本库" Style="{StaticResource IconButton}" FontSize="11" Padding="10,4"
                                Click="BtnLoadVersions_Click" ToolTip="把「版本管理」中保存的配置载入清单（自动勾选最新的 5 条）" />
                        <Button Content="从文件添加" Style="{StaticResource IconButton}" Margin="6,0,0,0" FontSize="11" Padding="10,4"
                                Click="BtnAddFiles_Click" ToolTip="添加本地 .cfg/.txt 配置文件到清单" />
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="GridPack" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          RowHeaderWidth="0" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="打包" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="44" />
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120" IsReadOnly="True" />
                        <DataGridTextColumn Header="信息" Binding="{Binding Detail}" Width="*" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,10" CornerRadius="6"
                        Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="全选" Style="{StaticResource IconButton}" Click="BtnSelectAll_Click" />
                            <Button Content="清空" Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnClearSel_Click" />
                            <Button Content="移除选中" Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnRemove_Click"
                                    ToolTip="把清单里勾选的行移除" />
                            <Button Content="清空清单" Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="BtnClearAll_Click" />
                        </StackPanel>
                        <TextBlock x:Name="TxtSummary" Text="清单为空" FontSize="11.5"
                                   Foreground="{StaticResource AccentCyanBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 右：包设置 + 说明预览 + 打包 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="交付包名称" FontSize="11" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtPackName" Margin="86,0,0,0" Padding="8,6" MaxLength="60"
                             ToolTip="将作为 ZIP 文件名，非法字符自动过滤" />
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                    <TextBlock x:Name="TxtReadme" Text="（勾选配置后自动生成交付说明）" FontSize="11.5"
                               Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" LineHeight="18" />
                </Border>

                <TextBox x:Name="TxtPreview" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                         Background="{StaticResource OutputBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                         Padding="10,8" VerticalScrollBarVisibility="Auto"
                         ToolTip="交付说明.txt 内容预览：导出 ZIP 时会自动写入包内" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="打包并导出 ZIP" Style="{StaticResource PrimaryButton}" Click="BtnPack_Click"
                            FontSize="13" Padding="22,8"
                            ToolTip="把勾选配置 + 交付说明压缩成一个 ZIP（可多个 .cfg 一起交付）" />
                    <TextBlock x:Name="TxtStatus" Text="" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
